{
  "name": "@polza-ai/dsh-plugin-polza",
  "version": "0.1.0",
  "description": "Polza.ai — российский LLM-агрегатор как провайдер моделей DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "assets",
    "locale",
    "docs"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/wrap-client.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "prepare": "tsdown && node scripts/wrap-client.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "tsdown": "0.23.7",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@earendil-works/pi-ai": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis-plugin-loader": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polza-ai/dsh-plugin-polza.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "polza",
    "llm"
  ],
  "icon": "./icon.svg",
  "author": "АО «ПОЛЬЗА.АИ» (Polza.AI) <https://polza.ai>",
  "homepage": "https://github.com/polza-ai/dsh-plugin-polza#readme",
  "bugs": {
    "url": "https://github.com/polza-ai/dsh-plugin-polza/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
